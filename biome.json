{
    "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": {
        "includes": [
            "**",
            "!experiments",
            "!**/*.md",
            "!.github/workflows/state-experiment.yml",
            "!pnpm-lock.yaml"
        ]
    },
    "formatter": { "indentStyle": "space", "indentWidth": 4, "lineWidth": 110 },
    "linter": {
        "rules": {
            "preset": "recommended",
            "suspicious": { "noExplicitAny": "error" },
            "style": { "noNonNullAssertion": "error", "useImportType": "error" }
        }
    }
}
